import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";

// kind: 0 = session header, 1 = directory, 2 = file
export struct TreeRow {
    kind: int,
    indent: int,
    name: string,
    expanded: bool,
    session: int,
    row-id: int,
    active: bool,
    selected: bool,
}

component TreeRowDelegate inherits Rectangle {
    in property <TreeRow> data;
    // Row an external (Finder) drag is currently hovering, -1 when none.
    in property <int> drop-row: -1;
    in property <bool> panel-focused: false;
    callback clicked();
    callback toggled();
    callback closed();
    callback context(int);

    property <bool> drop-target: root.drop-row == data.row-id;

    height: data.kind == 0 ? Theme.row-height * 1.2 : Theme.row-height;
    background: root.drop-target ? Theme.selection
        : (data.selected ? Theme.selection
        : (touch.has-hover ? Theme.panel-hover
        : (data.kind == 0 && data.active ? Theme.selection : transparent)));
    // A ring rather than a fill, so the row underneath stays readable while
    // the drag is in flight.
    border-width: root.drop-target ? 1px : 0px;
    border-color: Theme.accent;
    border-radius: root.drop-target || data.selected ? 3px : 0px;

    // Focused selection gets the accent bar; unfocused keeps the fill only,
    // matching how Finder dims an inactive list.
    if data.selected && !root.drop-target: Rectangle {
        x: 0;
        width: 2px;
        background: root.panel-focused ? Theme.accent : Theme.text-dim;
    }

    // action codes: 0 new file, 1 new folder, 2 reveal, 3 open default,
    // 4 copy path, 5 copy relative path, 6 duplicate, 7 rename, 8 trash,
    // 9 discard changes (changes-panel rows only), 10 discard all (changes
    // header), 11 cut, 12 copy file, 13 paste, 14 new folder from selection
    ctx-menu := ContextMenuArea {
        Menu {
            MenuItem { title: "New File…"; activated => { root.context(0); } }
            MenuItem { title: "New Folder…"; activated => { root.context(1); } }
            MenuSeparator { }
            MenuItem { title: "Cut"; activated => { root.context(11); } }
            MenuItem { title: "Copy"; activated => { root.context(12); } }
            MenuItem { title: "Paste"; activated => { root.context(13); } }
            MenuSeparator { }
            MenuItem { title: "Reveal in Finder"; activated => { root.context(2); } }
            MenuItem { title: "Open in Default App"; activated => { root.context(3); } }
            MenuSeparator { }
            MenuItem { title: "Copy Path"; activated => { root.context(4); } }
            MenuItem { title: "Copy Relative Path"; activated => { root.context(5); } }
            MenuSeparator { }
            MenuItem { title: "Duplicate"; activated => { root.context(6); } }
            MenuItem { title: "Rename…"; activated => { root.context(7); } }
            MenuItem { title: "Move to Trash"; activated => { root.context(8); } }
            if root.data.kind == 4: MenuSeparator { }
            if root.data.kind == 4: MenuItem {
                title: "Discard Changes…";
                activated => { root.context(9); }
            }
            if root.data.kind == 3: MenuSeparator { }
            if root.data.kind == 3: MenuItem {
                title: "Discard All Changes…";
                activated => { root.context(10); }
            }
        }
    }

    touch := TouchArea {
        clicked => {
            if (root.data.kind == 2 || root.data.kind == 4) {
                root.clicked();
            } else {
                root.toggled();
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                ctx-menu.show({ x: self.mouse-x, y: self.mouse-y });
            }
        }
    }

    HorizontalLayout {
        padding-left: 8px + data.indent * 14px;
        padding-right: 6px;
        spacing: 5px;

        if data.kind != 2 && data.kind != 4: Text {
            width: 12px;
            text: data.expanded ? "▾" : "▸";
            color: Theme.text-dim;
            font-size: Theme.font-size-tiny - 1px;
            vertical-alignment: center;
        }
        if data.kind == 2 || data.kind == 4: Rectangle { width: 12px; }

        Text {
            text: data.name;
            color: data.kind == 0 ? Theme.text : (data.kind == 1 ? Theme.text : Theme.text-dim);
            font-size: data.kind == 0 ? Theme.font-size : Theme.font-size-small;
            font-weight: data.kind == 0 || data.kind == 3 ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        // Remove-from-workbench button (the folder stays in Recent).
        if data.kind == 0: close-touch := TouchArea {
            width: 18px;
            Text {
                text: "✕";
                color: close-touch.has-hover ? Theme.text : Theme.text-dim;
                font-size: Theme.font-size-tiny - 1px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            clicked => { root.closed(); }
        }

        // Discard-all button on the Changes subheader.
        if data.kind == 3: discard-touch := TouchArea {
            width: 18px;
            Text {
                text: "↺";
                color: discard-touch.has-hover ? Theme.text : Theme.text-dim;
                font-size: Theme.font-size-tiny;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            clicked => { root.context(10); }
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <[TreeRow]> rows;
    in property <[string]> recent-folders;
    // Row an external drag is hovering (-1 none); Rust hit-tests it from the
    // geometry this component publishes below.
    in property <int> drop-row: -1;
    // Set while a Finder drag is over the window, so the panel can advertise
    // itself as a drop destination.
    in property <bool> drop-active: false;
    callback row-clicked(int);
    callback row-toggled(int);
    callback close-session(int);
    callback row-context(int, int);
    callback add-folder();
    callback recent-clicked(int);
    callback recent-forget(int);
    callback tree-key(string, bool, bool, bool, bool) -> bool;

    // Window-space geometry of the row list, so Rust can turn a pointer
    // position into a row during an external drag (winit's drop events carry
    // no coordinates, and Slint cannot hit-test on demand).
    out property <length> list-top: list.absolute-position.y;
    out property <length> list-height: list.height;
    out property <length> list-left: list.absolute-position.x;
    out property <length> list-width: list.width;
    // Two-way so Rust can scroll a keyboard-selected row back into view.
    in-out property <length> viewport-y <=> list.viewport-y;
    out property <length> scroll-y: -root.viewport-y;
    out property <bool> tree-focused: fs.has-focus;

    public function grab-focus() {
        fs.focus();
    }

    background: Theme.panel;

    VerticalLayout {
        Rectangle {
            height: Theme.header-height + 4px;
            HorizontalLayout {
                padding-left: 10px;
                Text {
                    text: "AGENTS";
                    color: Theme.text-dim;
                    font-size: Theme.font-size-tiny;
                    font-weight: 700;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }
            }
        }

        fs := FocusScope {
            vertical-stretch: 1;

            key-pressed(event) => {
                if (root.tree-key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.meta, event.modifiers.shift)) {
                    accept
                } else {
                    reject
                }
            }

            list := ListView {
                width: 100%;
                height: 100%;
                for row in root.rows: TreeRowDelegate {
                    data: row;
                    drop-row: root.drop-row;
                    panel-focused: fs.has-focus;
                    clicked => { root.row-clicked(row.row-id); }
                    toggled => { root.row-toggled(row.row-id); }
                    closed => { root.close-session(row.session); }
                    context(action) => { root.row-context(action, row.row-id); }
                }
            }

            // Whole-panel affordance: dropping outside any row lands in the
            // active session's root.
            if root.drop-active: Rectangle {
                background: transparent;
                border-width: 1px;
                border-color: Theme.accent;
                border-radius: 4px;
            }
        }

        bottom-bar := Rectangle {
            height: Theme.font-size * 3.1;
            border-width: 1px;
            border-color: Theme.border;

            recent-popup := PopupWindow {
                x: 4px;
                y: -(min(max(root.recent-folders.length, 1), 10) * (Theme.row-height + 4px) + 14px);
                width: root.width - 8px;
                close-policy: close-on-click-outside;

                Rectangle {
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 6px;

                    VerticalLayout {
                        padding: 4px;

                        if root.recent-folders.length == 0: Rectangle {
                            height: Theme.row-height + 4px;
                            Text {
                                text: "No recent folders";
                                color: Theme.text-dim;
                                font-size: Theme.font-size-small;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }

                        for folder[i] in root.recent-folders: recent-row := TouchArea {
                            height: Theme.row-height + 4px;
                            Rectangle {
                                background: recent-row.has-hover ? Theme.panel-hover : transparent;
                                border-radius: 4px;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 4px;
                                    spacing: 4px;
                                    Text {
                                        text: folder;
                                        color: Theme.text;
                                        font-size: Theme.font-size-small;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    forget-touch := TouchArea {
                                        width: 18px;
                                        Text {
                                            text: "✕";
                                            color: forget-touch.has-hover ? Theme.text : Theme.text-dim;
                                            font-size: Theme.font-size-tiny - 1px;
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                        }
                                        clicked => { root.recent-forget(i); }
                                    }
                                }
                            }
                            clicked => {
                                recent-popup.close();
                                root.recent-clicked(i);
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                add-touch := TouchArea {
                    horizontal-stretch: 1;
                    Rectangle {
                        background: add-touch.has-hover ? Theme.panel-hover : transparent;
                        Text {
                            text: "+ Add folder";
                            color: Theme.accent;
                            font-size: Theme.font-size;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                    clicked => { root.add-folder(); }
                }

                recent-touch := TouchArea {
                    width: 40px;
                    Rectangle {
                        background: recent-touch.has-hover ? Theme.panel-hover : transparent;
                        border-width: 1px;
                        border-color: Theme.border;
                        Text {
                            text: "⟳";
                            color: Theme.accent;
                            font-size: Theme.font-size-large;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                    clicked => { recent-popup.show(); }
                }
            }
        }
    }
}
