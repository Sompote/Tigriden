import { LineEdit, Button } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Sidebar, TreeRow } from "sidebar.slint";
import { SettingsDialog, AccentOption } from "settings.slint";

export { TreeRow, Theme, AccentOption }

export struct PresetItem {
    label: string,
}

// A pane that displays a Rust-rendered pixel buffer and forwards input.
// mouse kind: 0 = down, 1 = up, 2 = move, 3 = double-click
component PixelPane inherits Rectangle {
    in property <image> frame;
    out property <bool> pane-focused: fs.has-focus;
    callback key(string, bool, bool, bool, bool) -> bool;
    callback mouse(int, length, length);
    // delta-x, delta-y, and whether Ctrl/Cmd is held (zoom modifier).
    callback wheel(length, length, bool);
    callback size-changed(length, length);

    public function grab-focus() {
        fs.focus();
    }

    fs := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if (root.key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.meta, event.modifiers.shift)) {
                accept
            } else {
                reject
            }
        }

        Image {
            source: root.frame;
            image-fit: fill;
            image-rendering: pixelated;
            width: 100%;
            height: 100%;
        }

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    fs.focus();
                    root.mouse(0, self.mouse-x, self.mouse-y);
                } else if (event.kind == PointerEventKind.up) {
                    root.mouse(1, self.mouse-x, self.mouse-y);
                } else if (event.kind == PointerEventKind.move) {
                    root.mouse(2, self.mouse-x, self.mouse-y);
                }
            }
            double-clicked => {
                root.mouse(3, self.mouse-x, self.mouse-y);
            }
            scroll-event(event) => {
                root.wheel(event.delta-x, event.delta-y, event.modifiers.control || event.modifiers.meta);
                accept
            }
        }
    }

    changed width => { root.size-changed(self.width, self.height); }
    changed height => { root.size-changed(self.width, self.height); }
}

// Magnifying-glass button for the viewer header: a circled +/− with a
// handle, drawn with rectangles so it needs no emoji font.
component ZoomButton inherits TouchArea {
    in property <bool> zoom-in;
    width: 26px;
    Rectangle {
        y: 3px;
        height: Theme.chip-height;
        border-radius: 4px;
        background: root.has-hover ? Theme.panel-hover : transparent;
        glass := Rectangle {
            x: (parent.width - self.width) / 2 - 2px;
            y: (parent.height - self.height) / 2 - 2px;
            width: 11px;
            height: 11px;
            border-radius: 5.5px;
            border-width: 1.3px;
            border-color: root.has-hover ? Theme.text : Theme.text-dim;
            Text {
                width: 100%;
                height: 100%;
                text: root.zoom-in ? "+" : "−";
                color: glass.border-color;
                font-size: 9px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Path {
            x: glass.x + glass.width - 1.5px;
            y: glass.y + glass.height - 1.5px;
            width: 5px;
            height: 5px;
            viewbox-width: 10;
            viewbox-height: 10;
            stroke: glass.border-color;
            stroke-width: 1.5px;
            MoveTo { x: 1; y: 1; }
            LineTo { x: 9; y: 9; }
        }
    }
}

export component MainWindow inherits Window {
    in property <string> window-title: "Tigriden";
    title: window-title;
    icon: @image-url("../assets/icon-256.png");
    preferred-width: 1100px;
    preferred-height: 720px;
    background: Theme.bg;

    in property <[TreeRow]> tree-rows;
    in property <[string]> recent-folders;
    in property <[string]> team-names;
    in property <[PresetItem]> presets;
    in property <image> editor-frame;
    in property <image> term-frame;
    in-out property <float> split-ratio: 0.55;
    in property <string> editor-title: "";
    in property <bool> editor-dirty: false;
    in property <bool> has-session: false;
    in property <string> term-overlay: "";
    in property <string> banner-text: "";
    in property <[string]> term-tabs;
    in property <string> editor-view-toggle: "";
    in property <bool> viewer-zoomable: false;
    in property <bool> changes-enabled: false;
    in property <bool> name-dialog-visible: false;
    in property <string> name-dialog-title: "";
    in-out property <string> name-dialog-value: "";
    in property <int> active-term: 0;
    in property <string> banner-primary-label: "";
    in property <string> banner-secondary-label: "";

    // ----- settings -----
    in property <bool> settings-visible: false;
    in property <string> settings-mode: "dark";
    in property <string> settings-style: "classic";
    in property <string> settings-accent: "";
    in property <[AccentOption]> settings-accent-options;
    in property <[color]> settings-preview-colors;
    in property <string> settings-theme-label: "";
    in property <[string]> settings-font-families;
    in property <string> settings-font-family: "";
    in property <float> settings-font-size: 13;
    in property <float> settings-ui-font-size: 13;
    in property <int> settings-scrollback: 10000;
    in property <bool> settings-show-changes: false;
    in property <string> settings-config-path: "";

    callback row-clicked(int);
    callback row-toggled(int);
    callback close-session(int);
    callback add-folder();
    callback new-window(int);
    callback recent-clicked(int);
    callback recent-forget(int);
    callback preset-clicked(int);
    callback term-tab-clicked(int);
    callback new-terminal();
    callback close-terminal(int);
    callback menu-save();
    callback menu-copy();
    callback menu-paste();
    callback menu-select-all();
    callback menu-close-terminal();
    callback menu-close-session();
    callback tree-context(int, int);
    callback name-dialog-accept(string);
    callback name-dialog-cancel();
    callback settings-open();
    callback settings-changed(string, string);
    callback settings-close();
    callback settings-reset();
    callback settings-reveal-config();
    callback toggle-view();
    callback viewer-zoom-in();
    callback viewer-zoom-out();
    callback toggle-changes();
    callback split-changed();
    callback banner-primary();
    callback banner-secondary();
    callback term-key(string, bool, bool, bool, bool) -> bool;
    callback term-mouse(int, length, length);
    callback term-wheel(length);
    callback term-size-changed(length, length);
    callback editor-key(string, bool, bool, bool, bool) -> bool;
    callback editor-mouse(int, length, length);
    callback editor-wheel(length, length, bool);
    callback editor-size-changed(length, length);

    out property <bool> term-focused: term-pane.pane-focused;
    out property <bool> editor-focused: editor-pane.pane-focused;

    public function focus-terminal() {
        term-pane.grab-focus();
    }

    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "Add Folder…";
                shortcut: @keys(Control + O);
                activated => { root.add-folder(); }
            }
            MenuItem {
                title: "New Terminal";
                shortcut: @keys(Control + T);
                activated => { root.new-terminal(); }
            }
            MenuItem {
                title: root.changes-enabled ? "Hide Changes Panel" : "Show Changes Panel";
                activated => { root.toggle-changes(); }
            }
            Menu {
                title: "Open Recent";
                for folder[i] in root.recent-folders: MenuItem {
                    title: folder;
                    activated => { root.recent-clicked(i); }
                }
            }
            Menu {
                title: "New Window";
                MenuItem {
                    title: "Default";
                    activated => { root.new-window(-1); }
                }
                for name[i] in root.team-names: MenuItem {
                    title: name;
                    activated => { root.new-window(i); }
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Save";
                shortcut: @keys(Control + S);
                activated => { root.menu-save(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Settings…";
                shortcut: @keys(Control + ",");
                activated => { root.settings-open(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Close Terminal";
                shortcut: @keys(Control + W);
                activated => { root.menu-close-terminal(); }
            }
            MenuItem {
                title: "Close Folder";
                shortcut: @keys(Control + Shift + W);
                activated => { root.menu-close-session(); }
            }
        }
        Menu {
            title: "Edit";
            MenuItem {
                title: "Copy";
                shortcut: @keys(Control + C);
                activated => { root.menu-copy(); }
            }
            MenuItem {
                title: "Paste";
                shortcut: @keys(Control + V);
                activated => { root.menu-paste(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Select All";
                shortcut: @keys(Control + A);
                activated => { root.menu-select-all(); }
            }
        }
    }

    HorizontalLayout {
        Sidebar {
            width: 240px;
            rows: root.tree-rows;
            recent-folders: root.recent-folders;
            row-clicked(id) => { root.row-clicked(id); }
            row-toggled(id) => { root.row-toggled(id); }
            close-session(s) => { root.close-session(s); }
            add-folder => { root.add-folder(); }
            recent-clicked(i) => { root.recent-clicked(i); }
            recent-forget(i) => { root.recent-forget(i); }
            row-context(action, id) => { root.tree-context(action, id); }
        }

        Rectangle {
            width: 1px;
            background: Theme.border;
        }

        main-area := Rectangle {
            horizontal-stretch: 1;

            Text {
                visible: !root.has-session;
                text: "Add a folder to start an agent session";
                color: Theme.text-dim;
                font-size: Theme.font-size-large;
            }

            Rectangle {
                visible: root.has-session;
                width: 100%;
                height: 100%;

                editor-section := Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height * root.split-ratio - 3px;

                    VerticalLayout {
                        Rectangle {
                            height: Theme.header-height;
                            background: Theme.panel;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;
                                Text {
                                    text: root.editor-title == "" ? "No file open" : root.editor-title;
                                    color: root.editor-title == "" ? Theme.text-dim : Theme.text;
                                    font-size: Theme.font-size-small;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                if root.editor-dirty: Text {
                                    text: "●";
                                    color: Theme.accent;
                                    font-size: Theme.font-size-small;
                                    vertical-alignment: center;
                                }
                                if root.viewer-zoomable: ZoomButton {
                                    zoom-in: false;
                                    clicked => { root.viewer-zoom-out(); }
                                }
                                if root.viewer-zoomable: ZoomButton {
                                    zoom-in: true;
                                    clicked => { root.viewer-zoom-in(); }
                                }
                                if root.editor-view-toggle != "": toggle-touch := TouchArea {
                                    width: toggle-label.preferred-width + 18px;
                                    Rectangle {
                                        y: 3px;
                                        height: Theme.chip-height;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        background: toggle-touch.has-hover ? Theme.panel-hover : transparent;
                                        toggle-label := Text {
                                            text: root.editor-view-toggle;
                                            color: Theme.accent;
                                            font-size: Theme.font-size-tiny;
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                        }
                                    }
                                    clicked => { root.toggle-view(); }
                                }
                            }
                        }

                        if root.banner-text != "": Rectangle {
                            height: Theme.font-size * 2.4;
                            background: Theme.selection;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 12px;
                                Text {
                                    text: root.banner-text;
                                    color: Theme.text;
                                    font-size: Theme.font-size-small;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                primary-touch := TouchArea {
                                    width: primary-label.preferred-width + 16px;
                                    primary-label := Text {
                                        text: root.banner-primary-label;
                                        color: Theme.accent;
                                        font-size: Theme.font-size-small;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                    clicked => { root.banner-primary(); }
                                }
                                secondary-touch := TouchArea {
                                    width: secondary-label.preferred-width + 16px;
                                    secondary-label := Text {
                                        text: root.banner-secondary-label;
                                        color: Theme.text-dim;
                                        font-size: Theme.font-size-small;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                    clicked => { root.banner-secondary(); }
                                }
                            }
                        }

                        editor-pane := PixelPane {
                            vertical-stretch: 1;
                            frame: root.editor-frame;
                            key(t, c, a, m, s) => { root.editor-key(t, c, a, m, s) }
                            mouse(k, x, y) => { root.editor-mouse(k, x, y); }
                            wheel(dx, dy, zoom) => { root.editor-wheel(dx, dy, zoom); }
                            size-changed(w, h) => { root.editor-size-changed(w, h); }
                        }
                    }
                }

                splitter := TouchArea {
                    x: 0;
                    y: parent.height * root.split-ratio - 3px;
                    width: parent.width;
                    height: 6px;
                    mouse-cursor: ns-resize;
                    moved => {
                        if (self.pressed) {
                            root.split-ratio = Math.clamp((self.y + self.mouse-y) / main-area.height, 0.15, 0.85);
                            root.split-changed();
                        }
                    }
                    Rectangle {
                        y: 2px;
                        height: 1px;
                        background: Theme.border;
                    }
                }

                term-section := Rectangle {
                    x: 0;
                    y: parent.height * root.split-ratio + 3px;
                    width: parent.width;
                    height: parent.height - self.y;

                    VerticalLayout {
                        Rectangle {
                            height: Theme.header-height + 2px;
                            background: Theme.panel;
                            HorizontalLayout {
                                padding-left: 8px;
                                spacing: 4px;
                                alignment: start;

                                for label[i] in root.term-tabs: tab-touch := TouchArea {
                                    width: root.term-tabs.length > 1 && self.has-hover ? 46px : 30px;
                                    Rectangle {
                                        y: 4px;
                                        height: Theme.chip-height;
                                        border-radius: 4px;
                                        background: i == root.active-term ? Theme.selection
                                            : (tab-touch.has-hover ? Theme.panel-hover : transparent);
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 4px;
                                            spacing: 2px;
                                            Text {
                                                text: label;
                                                color: i == root.active-term ? Theme.text : Theme.text-dim;
                                                font-size: Theme.font-size-tiny;
                                                vertical-alignment: center;
                                            }
                                            if root.term-tabs.length > 1 && tab-touch.has-hover: TouchArea {
                                                width: 14px;
                                                Text {
                                                    text: "✕";
                                                    color: Theme.text-dim;
                                                    font-size: Theme.font-size-tiny - 2px;
                                                    vertical-alignment: center;
                                                    horizontal-alignment: center;
                                                }
                                                clicked => { root.close-terminal(i); }
                                            }
                                        }
                                    }
                                    clicked => { root.term-tab-clicked(i); }
                                }

                                new-term-touch := TouchArea {
                                    width: 24px;
                                    Rectangle {
                                        y: 4px;
                                        height: Theme.chip-height;
                                        border-radius: 4px;
                                        background: new-term-touch.has-hover ? Theme.panel-hover : transparent;
                                        Text {
                                            text: "+";
                                            color: Theme.accent;
                                            font-size: Theme.font-size;
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                        }
                                    }
                                    clicked => { root.new-terminal(); }
                                }

                                Rectangle {
                                    width: 1px;
                                    y: 6px;
                                    height: 18px;
                                    background: Theme.border;
                                }

                                for preset[i] in root.presets: preset-touch := TouchArea {
                                    width: preset-text.preferred-width + 20px;
                                    Rectangle {
                                        y: 4px;
                                        height: Theme.chip-height;
                                        border-radius: 4px;
                                        background: preset-touch.has-hover ? Theme.panel-hover : Theme.bg;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        preset-text := Text {
                                            text: preset.label;
                                            color: Theme.accent;
                                            font-size: Theme.font-size-tiny;
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                        }
                                    }
                                    clicked => { root.preset-clicked(i); }
                                }
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;

                            term-pane := PixelPane {
                                width: 100%;
                                height: 100%;
                                frame: root.term-frame;
                                key(t, c, a, m, s) => { root.term-key(t, c, a, m, s) }
                                mouse(k, x, y) => { root.term-mouse(k, x, y); }
                                wheel(dx, dy, zoom) => { root.term-wheel(dy); }
                                size-changed(w, h) => { root.term-size-changed(w, h); }
                            }

                            if root.term-overlay != "": Rectangle {
                                background: Theme.bg.with-alpha(0.8);
                                Text {
                                    text: root.term-overlay;
                                    color: Theme.text-dim;
                                    font-size: Theme.font-size-large;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.settings-visible: SettingsDialog {
        width: 100%;
        height: 100%;
        mode: root.settings-mode;
        style: root.settings-style;
        accent: root.settings-accent;
        accent-options: root.settings-accent-options;
        preview-colors: root.settings-preview-colors;
        theme-label: root.settings-theme-label;
        font-families: root.settings-font-families;
        font-family: root.settings-font-family;
        font-size: root.settings-font-size;
        ui-font-size: root.settings-ui-font-size;
        scrollback: root.settings-scrollback;
        show-changes: root.settings-show-changes;
        config-path: root.settings-config-path;
        changed(key, value) => { root.settings-changed(key, value); }
        close => { root.settings-close(); }
        reset => { root.settings-reset(); }
        reveal-config => { root.settings-reveal-config(); }
    }

    if root.name-dialog-visible: Rectangle {
        background: Theme.bg.with-alpha(0.6);
        TouchArea { clicked => { root.name-dialog-cancel(); } }
        Rectangle {
            width: 340px;
            height: 118px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 8px;
            TouchArea { }
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                Text {
                    text: root.name-dialog-title;
                    color: Theme.text;
                    font-size: Theme.font-size;
                    font-weight: 600;
                }
                name-input := LineEdit {
                    text <=> root.name-dialog-value;
                    font-size: Theme.font-size;
                    accepted => { root.name-dialog-accept(self.text); }
                    init => { self.focus(); }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Cancel";
                        clicked => { root.name-dialog-cancel(); }
                    }
                    Button {
                        text: "OK";
                        primary: true;
                        clicked => { root.name-dialog-accept(name-input.text); }
                    }
                }
            }
        }
    }
}
